<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SPECIAL permission: cannot be granted through requestPermissions().
      The user has to enable it manually in the system settings.
      Hence tools:ignore, which silences the lint warning about this "protected"
      permission.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Screen time reminders.

      POST_NOTIFICATIONS: a RUNTIME permission since API 33. Absent by default, and
      without it notify() does strictly nothing. Hence the explicit request in the
      settings screen.

      USE_EXACT_ALARM: a normal permission, granted at install time. It is what allows
      setExactAndAllowWhileIdle to wake the device while it is dozing.
      ⚠️ The Play Store reserves it for alarm and calendar apps. Acceptable here since
      the app is not published. A public release should go through SCHEDULE_EXACT_ALARM,
      which the user has to enable by hand in the settings.

      RECEIVE_BOOT_COMPLETED: alarms do not survive a reboot.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 11+ (API 30): without this block, getLaunchIntentForPackage() returns
      null even for an installed app. Every app we intend to launch MUST be declared
      here. This declaration exposes no data: it only says "this app interests me".
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.android.feurstagram" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hub"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="false": no other app should be able to trigger this receiver.
          System broadcasts (BOOT_COMPLETED) still reach a non-exported receiver —
          that is the normal case for one declared here.

          No <intent-filter> for the alarm: it is addressed explicitly by
          PendingIntent, so it is never resolved through a filter.
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>