<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permission SPÉCIALE : ne s'accorde pas via requestPermissions().
      L'utilisateur doit l'activer manuellement dans les réglages du système.
      D'où tools:ignore, qui désactive le lint sur cette permission "protégée".
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Rappels de temps d'écran.

      POST_NOTIFICATIONS : permission RUNTIME depuis l'API 33. Absente par défaut →
      sans elle, notify() ne fait strictement rien. D'où la demande explicite dans
      l'écran de réglages.

      USE_EXACT_ALARM : permission normale, accordée à l'installation. C'est ce qui
      autorise setExactAndAllowWhileIdle à réveiller le téléphone en veille.
      ⚠️ Le Play Store la réserve aux applis d'alarme/agenda : acceptable ici, l'app
      n'est pas publiée. Une version publique devrait passer par SCHEDULE_EXACT_ALARM,
      que l'utilisateur doit activer à la main dans les réglages.

      RECEIVE_BOOT_COMPLETED : les alarmes ne survivent pas au redémarrage.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 11+ (API 30) : sans ce bloc, getLaunchIntentForPackage() renvoie null
      même pour une app installée. Toute app qu'on compte lancer DOIT être déclarée ici.
      Cette déclaration n'expose aucune donnée : elle dit juste "cette app m'intéresse".
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.android.feurstagram" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hub"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="false" : aucune autre app ne doit déclencher ce receiver.
          Les broadcasts système (BOOT_COMPLETED) atteignent malgré tout un receiver
          non exporté — c'est le cas normal pour un récepteur déclaré ici.

          Pas de <intent-filter> pour l'alarme : elle est adressée explicitement par
          PendingIntent, donc jamais résolue par filtre.
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>